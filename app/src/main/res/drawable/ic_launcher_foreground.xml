<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a speedometer glyph (gauge ring + tick marks + needle),
  drawn in white so it reads clearly against the gradient background layer.
  All content is kept within the 66dp "safe zone" circle centered at (54,54)
  per Android's adaptive icon spec, so it survives circle/square/rounded-square masking.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gauge bezel ring -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 53.99,24"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Tick marks: one base tick, rotated around the gauge center to place five evenly -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-60">
        <path android:pathData="M54,20 L54,28" android:strokeColor="#FFFFFF" android:strokeWidth="3.5" android:strokeLineCap="round" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="-30">
        <path android:pathData="M54,20 L54,28" android:strokeColor="#FFFFFF" android:strokeWidth="3.5" android:strokeLineCap="round" />
    </group>
    <path android:pathData="M54,20 L54,28" android:strokeColor="#FFFFFF" android:strokeWidth="3.5" android:strokeLineCap="round" />
    <group android:pivotX="54" android:pivotY="54" android:rotation="30">
        <path android:pathData="M54,20 L54,28" android:strokeColor="#FFFFFF" android:strokeWidth="3.5" android:strokeLineCap="round" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path android:pathData="M54,20 L54,28" android:strokeColor="#FFFFFF" android:strokeWidth="3.5" android:strokeLineCap="round" />
    </group>

    <!-- Needle: drawn pointing straight up, then rotated to point up-and-right (a "fast" reading) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="45">
        <path
            android:pathData="M54,27 L58,54 L50,54 Z"
            android:fillColor="#FFFFFF" />
    </group>

    <!-- Center pivot -->
    <path
        android:pathData="M54,54 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#FFFFFF" />
</vector>
